{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blockdraft.de/schemas/build-spec-v1.json",
  "title": "BlockDraft BuildSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "category", "bounds", "palette", "operations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": {
      "type": "string",
      "enum": ["house", "tower", "bridge", "temple", "pavilion", "wall", "arena", "room", "other_architecture"]
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer", "minimum": 1, "maximum": 32 },
        "y": { "type": "integer", "minimum": 1, "maximum": 32 },
        "z": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "palette": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 12,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,31}$" },
      "additionalProperties": { "type": "string", "pattern": "^minecraft:[a-z0-9_]+$" }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 31 },
        { "type": "integer", "minimum": 0, "maximum": 31 },
        { "type": "integer", "minimum": 0, "maximum": 31 }
      ],
      "items": false
    },
    "size3": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1, "maximum": 32 },
        { "type": "integer", "minimum": 1, "maximum": 32 },
        { "type": "integer", "minimum": 1, "maximum": 32 }
      ],
      "items": false
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "min", "size"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" },
        "type": {
          "type": "string",
          "enum": ["box", "hollow_box", "wall", "line", "cylinder", "sphere", "dome", "gable_roof", "stairs", "place", "carve_box"]
        },
        "material": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "min": { "$ref": "#/$defs/vec3" },
        "size": { "$ref": "#/$defs/size3" },
        "to": { "$ref": "#/$defs/vec3" },
        "radius": { "type": "integer", "minimum": 1, "maximum": 16 },
        "thickness": { "type": "integer", "minimum": 1, "maximum": 4 },
        "hollow": { "type": "boolean" },
        "direction": { "type": "string", "enum": ["x+", "x-", "z+", "z-"] },
        "roofAxis": { "type": "string", "enum": ["x", "z"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "carve_box" } } },
          "then": { "not": { "required": ["material"] } },
          "else": { "required": ["material"] }
        }
      ]
    }
  }
}
