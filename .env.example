# Local demo values; replace VITE_* values for a real Firebase project.
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-voxelblueprint.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-voxelblueprint
VITE_FIREBASE_STORAGE_BUCKET=demo-voxelblueprint.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
VITE_USE_FIREBASE_EMULATORS=true
VITE_AI_PROVIDER=fake

# Only in a server/Cloud Function environment, never in VITE_*:
# Set VITE_AI_PROVIDER=gemini in the browser environment only when the local API is running.
# The server reads GEMINI_API_KEY and GEMINI_MODEL from its environment.
# GEMINI_PROFILE=fast
# Fast, low-latency default. Use gemini-3.5-flash only for an explicit quality profile.
# GEMINI_MODEL=gemini-3.1-flash-lite
# Cheap structured prompt optimizer; set false to disable the extra planning call.
# GEMINI_PROMPT_MODEL=gemini-3.1-flash-lite
# GEMINI_PROMPT_OPTIMIZER=true
# Second Gemini pass: returns a compact semantic part plan. Local compiler creates voxels.
# The old GEMINI_OBJECT_MODEL name remains a temporary compatibility fallback.
# GEMINI_VOXEL_MODEL=gemini-3-flash-preview
# GEMINI_REVIEW_MODEL=gemini-3.1-flash-lite
# GEMINI_API_KEY=
# OPENAI_API_KEY=
